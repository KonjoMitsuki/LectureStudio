LECTURE_VOICEVOX_URL=http://127.0.0.1:50021
LECTURE_VOICE_CONCURRENCY=2
LECTURE_CODEX_BIN=codex
LECTURE_CODEX_TIMEOUT=900
LECTURE_RENDER_TIMEOUT=7200
LECTURE_RENDER_CONCURRENCY=2
LECTURE_MAX_UPLOAD_MB=30
LECTURE_MAX_PAGES=100
# 既存ブラウザを利用する場合のみ指定
# LECTURE_CHROMIUM_PATH=/absolute/path/to/chrome
# 項目抽出と台本の分割単位（内容の省略・動画時間の制限ではありません）
LECTURE_PLAN_CHUNK_PAGES=3
LECTURE_CHAPTER_TOPICS=6
LECTURE_CHUNK_TEXT_CHARS=12000
# Manimは同じ.venvを使用。別環境にはbackend依存も導入し、Pythonの絶対パスを指定
# LECTURE_MANIM_PYTHON=/absolute/path/to/manim-venv/bin/python
LECTURE_MANIM_TIMEOUT=600
