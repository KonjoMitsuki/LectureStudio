{
  "$defs": {
    "Animation": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "enum": [
            "array",
            "tree",
            "graph",
            "formula",
            "complexity"
          ],
          "title": "Template",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 6,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 10,
          "title": "Edges",
          "type": "array"
        },
        "states": {
          "items": {
            "$ref": "#/$defs/AnimationState"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "States",
          "type": "array"
        },
        "curves": {
          "items": {
            "enum": [
              "constant",
              "log",
              "linear",
              "n_log_n",
              "quadratic",
              "cubic"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Curves",
          "type": "array"
        }
      },
      "required": [
        "template",
        "nodes",
        "edges",
        "states",
        "curves"
      ],
      "title": "Animation",
      "type": "object"
    },
    "AnimationState": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 8,
          "title": "Values",
          "type": "array"
        },
        "highlight": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Highlight",
          "type": "array"
        },
        "label": {
          "default": "",
          "maxLength": 80,
          "title": "Label",
          "type": "string"
        },
        "formula": {
          "default": "",
          "maxLength": 160,
          "title": "Formula",
          "type": "string"
        },
        "cue": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cue",
          "type": "string"
        }
      },
      "required": [
        "values",
        "highlight",
        "label",
        "formula",
        "cue"
      ],
      "title": "AnimationState",
      "type": "object"
    },
    "Beat": {
      "additionalProperties": false,
      "properties": {
        "cue": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cue",
          "type": "string"
        },
        "transition_seconds": {
          "default": 0.5,
          "maximum": 2,
          "minimum": 0,
          "title": "Transition Seconds",
          "type": "number"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "cue",
        "transition_seconds",
        "changes"
      ],
      "title": "Beat",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "title": "Target",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1696,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 668,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 1696,
              "minimum": -1696,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "maximum": 668,
              "minimum": -668,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "font_size": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 28,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "fg",
                "muted",
                "accent",
                "warm",
                "cool"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "fill": {
          "anyOf": [
            {
              "enum": [
                "none",
                "card",
                "accent",
                "warm",
                "cool"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill"
        },
        "opacity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opacity"
        }
      },
      "required": [
        "target",
        "x",
        "y",
        "width",
        "height",
        "text",
        "font_size",
        "tone",
        "fill",
        "opacity"
      ],
      "title": "Change",
      "type": "object"
    },
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "topic_id": {
          "pattern": "^topic_[0-9]{4}$",
          "title": "Topic Id",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^scene_[0-9]{3,6}$",
          "title": "Scene Id",
          "type": "string"
        },
        "narration_excerpt": {
          "maxLength": 400,
          "minLength": 10,
          "title": "Narration Excerpt",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "scene_id",
        "narration_excerpt"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "maxLength": 20,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "label"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "rect",
            "ellipse",
            "line",
            "arrow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "maximum": 1696,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 668,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "maximum": 1696,
          "minimum": -1696,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "maximum": 668,
          "minimum": -668,
          "title": "Height",
          "type": "number"
        },
        "text": {
          "default": "",
          "maxLength": 160,
          "title": "Text",
          "type": "string"
        },
        "font_size": {
          "default": 44,
          "maximum": 120,
          "minimum": 28,
          "title": "Font Size",
          "type": "number"
        },
        "align": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "tone": {
          "default": "fg",
          "enum": [
            "fg",
            "muted",
            "accent",
            "warm",
            "cool"
          ],
          "title": "Tone",
          "type": "string"
        },
        "fill": {
          "default": "none",
          "enum": [
            "none",
            "card",
            "accent",
            "warm",
            "cool"
          ],
          "title": "Fill",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "width",
        "height",
        "text",
        "font_size",
        "align",
        "tone",
        "fill",
        "opacity"
      ],
      "title": "Element",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 28,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Node",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^scene_[0-9]{3,6}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "narration": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "concepts": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Concepts",
          "type": "array"
        },
        "source_pages": {
          "items": {
            "type": "integer"
          },
          "maxItems": 20,
          "title": "Source Pages",
          "type": "array"
        },
        "supplemental": {
          "title": "Supplemental",
          "type": "boolean"
        },
        "estimated_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Estimated Seconds",
          "type": "number"
        },
        "visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/Visual"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "default": "lecture",
          "enum": [
            "lecture",
            "quiz",
            "quiz_answer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "thinking_seconds": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Thinking Seconds",
          "type": "integer"
        },
        "renderer": {
          "default": "remotion",
          "enum": [
            "remotion",
            "manim"
          ],
          "title": "Renderer",
          "type": "string"
        },
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Animation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "storyboard": {
          "anyOf": [
            {
              "$ref": "#/$defs/Storyboard"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "narration",
        "concepts",
        "source_pages",
        "supplemental",
        "estimated_seconds",
        "visual",
        "kind",
        "thinking_seconds",
        "renderer",
        "animation",
        "storyboard"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "reveal",
            "highlight_node",
            "highlight_edge",
            "highlight_item"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "cue": {
          "default": "",
          "maxLength": 80,
          "title": "Cue",
          "type": "string"
        }
      },
      "required": [
        "action",
        "target",
        "cue"
      ],
      "title": "Step",
      "type": "object"
    },
    "Storyboard": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "maxItems": 32,
          "title": "Beats",
          "type": "array"
        }
      },
      "required": [
        "intent",
        "elements",
        "beats"
      ],
      "title": "Storyboard",
      "type": "object"
    },
    "Visual": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "flowchart",
            "state_diagram",
            "block_diagram",
            "network",
            "timeline",
            "comparison",
            "formula",
            "keywords"
          ],
          "title": "Type",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 6,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 10,
          "title": "Edges",
          "type": "array"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Items",
          "type": "array"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 5,
          "title": "Rows",
          "type": "array"
        },
        "formula": {
          "maxLength": 160,
          "title": "Formula",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 12,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "type",
        "nodes",
        "edges",
        "items",
        "columns",
        "rows",
        "formula",
        "steps"
      ],
      "title": "Visual",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "learning_goals": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Learning Goals",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Warnings",
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "maxItems": 12000,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageEntry"
      },
      "maxItems": 1200,
      "title": "Coverage",
      "type": "array"
    }
  },
  "required": [
    "title",
    "learning_goals",
    "warnings",
    "scenes",
    "coverage"
  ],
  "title": "Lecture",
  "type": "object"
}